CLIENT_URL=https://www.profixter.com
MONGO_URI=
JWT_SECRET=
JWT_RESET_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Optional one-time save offer shown before self-serve membership cancellation.
# Configure with the Stripe "once" coupon ID for 30% off the next renewal.
STRIPE_RETENTION_COUPON_ID=
# Nightly Stripe-linked subscription reconciliation runs by default.
# Set to false only for controlled maintenance.
STRIPE_RECONCILIATION_ENABLED=true
# Optional Stripe price overrides. If omitted, backend resolves active Stripe
# prices by metadata, then falls back to the legacy built-in mapping.
STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_BASIC_ANNUAL=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_ELITE_ANNUAL=
STRIPE_PRICE_ONE_TIME_HANDYMAN_VISIT=
MAIL_ADMIN=
# Optional additional inbox for public lead notifications.
LEADS_EMAIL=
MAIL_FROM=Profixter <no-reply@profixter.com>
MAIL_REPLY_TO=getfixter@gmail.com
MARKETING_FROM=
PUBLIC_API_URL=https://api.profixter.com
EMAIL_UNSUBSCRIBE_SECRET=
EMAIL_BATCH_SIZE=10
EMAIL_BATCH_DELAY_MS=300
AWS_SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_SMTP_PORT=587
AWS_SES_SMTP_USER=
AWS_SES_SMTP_PASS=
BOOKING_REMINDERS_ENABLED=true
# Delayed review emails run by default. Set false to pause without code changes.
BOOKING_REVIEW_REQUESTS_ENABLED=true
ONE_TIME_VISIT_ENABLED=true
ONE_TIME_VISIT_PRICE_CENTS=9900
ONE_TIME_VISIT_DURATION_MINUTES=90
ONE_TIME_VISIT_HOLD_MINUTES=30
ONE_TIME_VISIT_CANCELLATION_PHONE=631-599-1363
# Pipe-separated overrides; leave blank to use the built-in one-time visit lists.
ONE_TIME_VISIT_ALLOWED_SERVICES=
ONE_TIME_VISIT_EXCLUDED_SERVICES=
ONE_TIME_VISIT_PROMO_NOTE=
ONE_TIME_VISIT_HOLD_CLEANUP_ENABLED=true
ONE_TIME_VISIT_HOLD_CLEANUP_MS=300000
OPENAI_API_KEY=
HOME_SUPPORT_AI_MODEL=gpt-4o-mini
HOME_SUPPORT_AI_RETENTION_DAYS=30
HOME_SUPPORT_AI_MAX_UPLOAD_MB=15
# Existing GHL integrations. Do not use this token for AI Commander.
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Parent company/agency ID for GHL v3 user search. If omitted, Jarvis tries to
# derive this from the configured location before resolving users.
GHL_COMPANY_ID=
# Internal admin-only GHL AI Commander. Set false for emergency shutdown.
AI_COMMANDER_GHL_ENABLED=true
AI_COMMANDER_OPENAI_MODEL=gpt-4o-mini
GHL_AI_COMMANDER_TOKEN=
AI_COMMANDER_GHL_API_VERSION=v3
# Specialized Jarvis skill for inbound GHL roofing/siding SMS replies.
# Default is disabled and suggestion-only; enable auto_reply_safe only after testing.
JARVIS_ROOFING_AGENT_ENABLED=false
JARVIS_ROOFING_AGENT_MODE=suggest_only
JARVIS_GHL_WEBHOOK_SECRET=
JARVIS_ADMIN_ALERT_PHONE=
JARVIS_ADMIN_ALERT_EMAIL=
# Optional GHL IDs used only when callback scheduling side effects are enabled.
JARVIS_ROOFING_AGENT_PIPELINE_ID=
JARVIS_ROOFING_AGENT_PIPELINE_STAGE_ID=
JARVIS_ROOFING_AGENT_ASSIGNED_TO=
# Legacy marketing automations are opt-in. Keep false unless intentionally enabled.
WEEKLY_NUDGE_ENABLED=false
CHATBOT_FOLLOWUPS_ENABLED=false
NURTURE_ENABLED=false
NURTURE_START_DATE=
# Reservation/customer cutover flags remain disabled until readiness passes.
ENABLE_RESERVATION_ENGINE=false
ENABLE_CUSTOMER_AVAILABILITY_PREVIEW=false
# Set true only after the production transaction probe exits successfully.
MONGO_TRANSACTIONS_VERIFIED=false

# --- Adobe Acrobat Sign e-signature ---------------------------------------
# Use EITHER an integration key OR the OAuth trio. The integration key wins if
# both are set. Leave all blank to run with e-signature disabled: the admin UI
# reports "not configured" and refuses to send, and nothing else is affected.
# Integration key: Account Settings > Acrobat Sign API > API Information.
ADOBE_SIGN_INTEGRATION_KEY=
# OAuth: Account Settings > Acrobat Sign API > API Applications.
ADOBE_SIGN_CLIENT_ID=
ADOBE_SIGN_CLIENT_SECRET=
# Minted once by: node scripts/adobe_oauth_bootstrap.js
ADOBE_SIGN_REFRESH_TOKEN=
# Used ONLY by that bootstrap script. Must byte-for-byte match the Redirect URI
# registered on the Adobe application. Adobe requires https, even on localhost.
# Nothing listens on this address; the script reads the code from the browser.
ADOBE_SIGN_REDIRECT_URI=https://localhost:8443/adobe/callback
# Space-separated. Blank uses the five scopes the integration actually needs.
ADOBE_SIGN_SCOPES=
# The shard your Acrobat Sign account lives on: na1, na2, na4, eu1, jp1, ...
# Visible in the address bar when signed in (https://secure.na4.adobesign.com/).
# Accounts AND OAuth applications are shard-bound - the wrong shard fails with
# "the client configuration is invalid: invalid_request". Used by the bootstrap
# script to build the authorization URL.
ADOBE_SIGN_SHARD=
# Must point at that same shard. The bootstrap script prints the correct value,
# confirmed against /baseUris. The built-in default is na1 and will be WRONG
# for any account on another shard.
ADOBE_SIGN_TOKEN_HOST=https://api.na1.adobesign.com
# The value Adobe echoes in X-AdobeSign-ClientId. Defaults to
# ADOBE_SIGN_CLIENT_ID when blank. Required for the webhook to accept anything.
ADOBE_SIGN_WEBHOOK_CLIENT_ID=
# Public HTTPS base URL of this API. Required for automatic webhook
# provisioning: the server registers https://<this>/api/esign/webhook/adobe-sign
# with Adobe on boot, and Adobe calls it back to verify it.
PUBLIC_API_BASE_URL=
# Webhook auto-provisioning is on whenever it can work. Set "false" to stop the
# server managing its own webhook (it will then never create or repair one).
ESIGN_WEBHOOK_AUTO_PROVISION=true
# Optional countersigner. When blank, only the customer signs.
ESIGN_COMPANY_SIGNER_EMAIL=
# Private S3 prefixes. Defaults shown; documents are never publicly readable.
ESIGN_S3_PREFIX=private/admin/esign
CHANGE_ORDER_S3_PREFIX=private/admin/change-orders

# Full Day Fixter
STRIPE_PRICE_FULL_DAY_VISIT=
FULL_DAY_VISIT_ENABLED=true
FULL_DAY_VISIT_PRICE_CENTS=49900
FULL_DAY_VISIT_APPROX_HOURS=8
FULL_DAY_VISIT_HOLD_MINUTES=30
FULL_DAY_VISIT_CANCELLATION_PHONE=631-599-1363

# Lifecycle marketing email
# OFF by default and deliberately so: deploying the code and switching marketing
# on are two separate decisions. Everything below is inert until this is "true".
ENABLE_MARKETING_EMAILS=false
# Batch size. The defaults are a ramp, not a throttle: nobody in the database
# has any marketing history, so on the first morning every customer is eligible
# at once. Raise these only once the first batches have been reviewed.
MARKETING_MAX_PER_RUN=10
MARKETING_MAX_PER_DAY=25
# Send window, New York time. Weekdays only; the weekend exclusion is in code.
MARKETING_SEND_START_HOUR=10
MARKETING_SEND_END_HOUR=11
MARKETING_SEND_END_MINUTE=30
# Hard floor between any two marketing emails to the same person, in days.
MARKETING_MIN_DAYS=7
# Base URL for marketing links. Defaults to https://www.profixter.com and is
# deliberately NOT derived from CLIENT_URL or PUBLIC_SITE_BASE_URL, both of
# which are the apex and answer with a redirect.
MARKETING_SITE_BASE_URL=https://www.profixter.com
# Which audiences may receive marketing. Comma separated, from
# member,non_member,former_member. Blank means all three. This is the ramp
# dial: set it to "member" for the first week so the domain earns a sending
# reputation on the people least likely to report us as spam.
MARKETING_AUDIENCES=
# How long before a person may receive the SAME campaign again, in days.
# 450 is fifteen months. This is a content rule; duplicate protection is a
# database index and is unaffected by it.
MARKETING_REUSE_DAYS=450
# Share of a person's marketing that should be helpful rather than selling.
MARKETING_HELP_TARGET=0.65
# Months charged for an annual membership. The copy promises ten, and the
# Stripe price gate refuses to run annual campaigns unless the configured
# price equals the monthly price times this number.
MARKETING_ANNUAL_MONTHS=10
# Dedicated secret for unsubscribe links, so rotating JWT_SECRET does not
# invalidate opt-out links already sitting in customers' inboxes. Tokens signed
# with the old JWT_SECRET keep working.
EMAIL_UNSUBSCRIBE_SECRET=
