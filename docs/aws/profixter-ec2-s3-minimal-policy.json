{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppObjectsInTheUploadsBucketOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::profixter-uploads-prod/*"
    },
    {
      "Sid": "ListSoMissingFilesStayNotFound",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::profixter-uploads-prod"
    }
  ]
}
