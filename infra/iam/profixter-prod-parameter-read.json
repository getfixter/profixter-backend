{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProfixterProdParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:us-east-1:213308313346:parameter/profixter/prod",
        "arn:aws:ssm:us-east-1:213308313346:parameter/profixter/prod/*"
      ]
    },
    {
      "Sid": "DecryptViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" } }
    }
  ]
}
