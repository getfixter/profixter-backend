{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadProfixterProdParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:us-east-1:213308313346:parameter/profixter/prod",
        "arn:aws:ssm:us-east-1:213308313346:parameter/profixter/prod/*"
      ]
    },
    {
      "Sid": "DecryptOnlyProfixterProdParametersViaSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:213308313346:key/e54ec974-3beb-4456-a900-ef8dd19a5226",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" },
        "StringLike": { "kms:EncryptionContext:PARAMETER_ARN": "arn:aws:ssm:us-east-1:213308313346:parameter/profixter/prod/*" }
      }
    }
  ]
}
